#
# Xiaomi ax6 (IPQ8071A, 512 MB) — the reference build.
#
# Concatenated onto devices/common/config by prepare-build.sh.
#

CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6=y


## zapret2
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_coreutils-sleep=y
CONFIG_PACKAGE_coreutils-sort=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=y
CONFIG_PACKAGE_luci-app-upnp=y

# Compressed swap in RAM for the boards with the least of it.
CONFIG_PACKAGE_zram-swap=y
